#!/usr/bin/env bash

# Live Claude Code usage dashboard: real session/week quota (from claude-statusline's
# cache of Anthropic's rate_limits) plus local token/burn-rate stats (from ccusage,
# kept warm by claude-usage-updater so this renders instantly).
command -v ccusage &>/dev/null || bun add -g ccusage

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
CACHE_DIR="$HOME/.cache/claude-usage"
RATE_LIMITS_CACHE="$CACHE_DIR/rate_limits.json"
BLOCK_CACHE="$CACHE_DIR/block.txt"
UPDATER_PIDFILE="$CACHE_DIR/updater.pid"

# Kanagawa-ish palette, consistent with claude-statusline
green='\033[38;5;151m'   # springGreen — safe
yellow='\033[38;5;179m'  # carpYellow — warning
red='\033[38;5;167m'     # autumnRed — danger
gray='\033[38;5;240m'    # sumi_ink — dim text
bold='\033[1m'
reset='\033[0m'

# Ensure the cache-warming daemon is running, starting it if not.
ensure_updater() {
  mkdir -p "$CACHE_DIR"
  if [ -f "$UPDATER_PIDFILE" ] && kill -0 "$(cat "$UPDATER_PIDFILE")" 2>/dev/null; then
    return
  fi
  nohup "$SCRIPT_DIR/claude-usage-updater" >/dev/null 2>&1 &
  disown
  echo $! >"$UPDATER_PIDFILE"
}

# Color for a given used-percentage: green < 50, yellow < 80, red >= 80.
color_for() {
  local pct=$1
  if ((pct >= 80)); then
    echo "$red"
  elif ((pct >= 50)); then
    echo "$yellow"
  else
    echo "$green"
  fi
}

# Draw a [#####.....] NN% bar, colored by severity. Args: used_percentage
bar() {
  local pct=$1 width=30
  local color=$(color_for "$pct")
  local filled=$((pct * width / 100))
  ((filled > width)) && filled=$width
  local empty=$((width - filled))
  printf '%b[' "$color"
  printf '%0.s#' $(seq 1 "$filled") 2>/dev/null
  printf '%b' "$gray"
  printf '%0.s.' $(seq 1 "$empty") 2>/dev/null
  printf '%b]%b %b%3d%%%b' "$reset" "$color" "$bold" "$pct" "$reset"
}

# Human-readable countdown to a unix epoch. Args: resets_at
until_reset() {
  local now=$(date +%s) resets_at=$1
  local secs=$((resets_at - now))
  ((secs < 0)) && secs=0
  printf '%dh %dm' $((secs / 3600)) $(((secs % 3600) / 60))
}

render_rate_limits() {
  if [ ! -f "$RATE_LIMITS_CACHE" ]; then
    printf '%b(no rate-limit data yet — open any Claude Code session to populate it)%b\n' "$gray" "$reset"
    return
  fi

  local five_hour_pct seven_day_pct five_hour_reset seven_day_reset
  five_hour_pct=$(jq -r '.five_hour.used_percentage // empty' "$RATE_LIMITS_CACHE")
  seven_day_pct=$(jq -r '.seven_day.used_percentage // empty' "$RATE_LIMITS_CACHE")
  five_hour_reset=$(jq -r '.five_hour.resets_at // empty' "$RATE_LIMITS_CACHE")
  seven_day_reset=$(jq -r '.seven_day.resets_at // empty' "$RATE_LIMITS_CACHE")

  if [ -n "$five_hour_pct" ]; then
    printf '%bSession (5h)%b  ' "$bold" "$reset"
    bar "${five_hour_pct%.*}"
    [ -n "$five_hour_reset" ] && printf '%b  (resets in %s)%b' "$gray" "$(until_reset "$five_hour_reset")" "$reset"
    echo
  fi
  if [ -n "$seven_day_pct" ]; then
    printf '%bWeek (7d)   %b  ' "$bold" "$reset"
    bar "${seven_day_pct%.*}"
    [ -n "$seven_day_reset" ] && printf '%b  (resets in %s)%b' "$gray" "$(until_reset "$seven_day_reset")" "$reset"
    echo
  fi
}

tput civis
trap 'tput cnorm' EXIT

ensure_updater

clear
while true; do
  tput cup 0 0
  render_rate_limits
  echo
  if [ -f "$BLOCK_CACHE" ]; then
    cat "$BLOCK_CACHE"
  else
    printf '%b(warming up local usage stats…)%b\n' "$gray" "$reset"
  fi
  echo
  printf '%bRefreshing every 5s — press any key to refresh now, q to close%b\n' "$gray" "$reset"
  tput ed
  read -rt 5 -n 1 key
  [[ "$key" == "q" ]] && break
done
