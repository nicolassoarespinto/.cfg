#!/usr/bin/env bash

# Kanagawa-inspired colors (muted, natural tones)
spring_violet='\033[38;5;103m'  # Purple-gray for model
wave_aqua='\033[38;5;108m'      # Teal for git
autumn_orange='\033[38;5;179m'  # Muted orange for project
sumi_ink='\033[38;5;240m'       # Muted gray for separators
reset='\033[0m'

# Read JSON input from stdin
input=$(cat)

# Cache rate_limits (five_hour/seven_day session+week quota) for claude-usage to read
usage_cache_dir="$HOME/.cache/claude-usage"
mkdir -p "$usage_cache_dir"
rate_limits=$(echo "$input" | jq -c '.rate_limits // empty')
[ -n "$rate_limits" ] && echo "$rate_limits" >"$usage_cache_dir/rate_limits.json"

# Extract values
model=$(echo "$input" | jq -r '.model.display_name // "unknown"' | sed 's/Claude //')
project_dir=$(echo "$input" | jq -r '.workspace.project_dir // "."')

# Get relative path from home directory
project="${project_dir/#$HOME\//}"

# Get git branch
git_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")

# Build minimal statusline
statusline="${autumn_orange}${project}${reset}"

if [ -n "$git_branch" ]; then
  statusline+="${sumi_ink} · ${reset}${wave_aqua}${git_branch}${reset}"
fi

statusline+="${sumi_ink} · ${reset}${spring_violet}${model}${reset}"

echo -e "$statusline"
