#!/usr/bin/env bash

# Live Claude Code usage dashboard: real session/week quota (from claude-statusline's
# cache of Anthropic's rate_limits) plus local token/burn-rate stats (from ccusage).
command -v ccusage &>/dev/null || bun add -g ccusage

RATE_LIMITS_CACHE="$HOME/.cache/claude-usage/rate_limits.json"

# Draw a [#####.....] NN% bar. Args: used_percentage
bar() {
  local pct=$1 width=30
  local filled=$((pct * width / 100))
  ((filled > width)) && filled=$width
  local empty=$((width - filled))
  printf '['
  printf '%0.s#' $(seq 1 "$filled") 2>/dev/null
  printf '%0.s.' $(seq 1 "$empty") 2>/dev/null
  printf '] %3d%%' "$pct"
}

# Human-readable countdown to a unix epoch. Args: resets_at
until_reset() {
  local now=$(date +%s) resets_at=$1
  local secs=$((resets_at - now))
  ((secs < 0)) && secs=0
  printf '%dh %dm' $((secs / 3600)) $(((secs % 3600) / 60))
}

render_rate_limits() {
  if [ ! -f "$RATE_LIMITS_CACHE" ]; then
    echo "(no rate-limit data yet — open any Claude Code session to populate it)"
    return
  fi

  local five_hour_pct seven_day_pct five_hour_reset seven_day_reset
  five_hour_pct=$(jq -r '.five_hour.used_percentage // empty' "$RATE_LIMITS_CACHE")
  seven_day_pct=$(jq -r '.seven_day.used_percentage // empty' "$RATE_LIMITS_CACHE")
  five_hour_reset=$(jq -r '.five_hour.resets_at // empty' "$RATE_LIMITS_CACHE")
  seven_day_reset=$(jq -r '.seven_day.resets_at // empty' "$RATE_LIMITS_CACHE")

  if [ -n "$five_hour_pct" ]; then
    printf 'Session (5h)  '
    bar "${five_hour_pct%.*}"
    [ -n "$five_hour_reset" ] && printf '  (resets in %s)' "$(until_reset "$five_hour_reset")"
    echo
  fi
  if [ -n "$seven_day_pct" ]; then
    printf 'Week (7d)     '
    bar "${seven_day_pct%.*}"
    [ -n "$seven_day_reset" ] && printf '  (resets in %s)' "$(until_reset "$seven_day_reset")"
    echo
  fi
}

tput civis
trap 'tput cnorm' EXIT

clear
while true; do
  tput cup 0 0
  render_rate_limits
  echo
  ccusage blocks --active --offline | tail -n +8
  echo
  echo "Refreshing every 30s — press any key to refresh now, q to close"
  tput ed
  read -rt 30 -n 1 key
  [[ "$key" == "q" ]] && break
done
