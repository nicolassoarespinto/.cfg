#!/usr/bin/env bash

# Interactive worktree selector using fzf
# Allows quick navigation between worktrees of the same git repository

set -e
set -u
set -o pipefail

# Check if fzf is installed
if ! command -v fzf >/dev/null 2>&1; then
  echo "Error: fzf is not installed. Please install it first." >&2
  exit 1
fi

# Check if we're in a git repository
if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "Error: Not in a git repository." >&2
  exit 1
fi

# --git-common-dir always points at the main repo's .git directory, even
# when run from inside a linked worktree, so this correctly identifies the
# main worktree regardless of where git-cd is invoked from.
MAIN_GIT_DIR=$(git rev-parse --path-format=absolute --git-common-dir)
MAIN_WORKTREE=$(dirname "$MAIN_GIT_DIR")
PROJECT_NAME=$(basename "$MAIN_WORKTREE")
CURRENT_DIR=$(pwd)

# Get all existing worktrees
declare -A WORKTREE_BRANCHES
while IFS= read -r line; do
  worktree_path=$(echo "$line" | awk '{print $1}')
  if [ -d "$worktree_path" ]; then
    branch_name=$(cd "$worktree_path" && git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
    WORKTREE_BRANCHES["$branch_name"]="$worktree_path"
  fi
done < <(git worktree list --porcelain | grep '^worktree ' | sed 's/^worktree //')

# Get all branches (local and remote)
ALL_BRANCHES=()
while IFS= read -r branch; do
  # Remove remote prefix and duplicates
  branch=$(echo "$branch" | sed 's/^origin\///')
  ALL_BRANCHES+=("$branch")
done < <(git branch -a --format='%(refname:short)' | grep -v 'HEAD' | sort -u)

# Create display list with both worktrees and available branches
DISPLAY_LIST=""
WORKTREE_COUNT=0
BRANCH_COUNT=0

for branch in "${ALL_BRANCHES[@]}"; do
  if [ -n "${WORKTREE_BRANCHES[$branch]:-}" ]; then
    # Branch has a worktree
    worktree_path="${WORKTREE_BRANCHES[$branch]}"

    if [ "$worktree_path" = "$MAIN_WORKTREE" ]; then
      display_label="[main]"
    else
      display_label=$(basename "$worktree_path")
    fi

    # Colorize existing worktrees in the fzf list.
    DISPLAY_LIST+="WORKTREE|$worktree_path|$branch|[32m$display_label[0m"$'\n'
    WORKTREE_COUNT=$((WORKTREE_COUNT + 1))
  else
    # Branch without worktree
    DISPLAY_LIST+="BRANCH|$branch|$branch|[no worktree]"$'\n'
    BRANCH_COUNT=$((BRANCH_COUNT + 1))
  fi
done

# Remove trailing newline
DISPLAY_LIST="${DISPLAY_LIST%$'\n'}"

echo "Found $WORKTREE_COUNT worktree(s) and $BRANCH_COUNT branch(es) without worktrees" >&2
echo >&2

# Use fzf to select a worktree or branch
SELECTED=$(echo "$DISPLAY_LIST" | fzf \
  --height=40% \
  --border \
  --delimiter="|" \
  --with-nth=3,4 \
  --ansi \
  --prompt="Select worktree/branch: " \
  --preview='
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    TYPE=$(echo {} | cut -d"|" -f1)
    if [ "$TYPE" = "WORKTREE" ]; then
      WT_PATH=$(echo {} | cut -d"|" -f2)
      printf "\\033[1;34m=== EXISTING WORKTREE ===\\033[0m\\n"
      echo ""
      printf "\\033[1;33mRecent commits:\\033[0m\\n"
      git -C "$WT_PATH" -c color.ui=always log --oneline -5 2>/dev/null || echo "No commits found"
      echo ""
      printf "\\033[1;33mStatus:\\033[0m\\n"
      git -C "$WT_PATH" -c color.ui=always status -sb 2>/dev/null || echo "No status available"
    else
      BRANCH=$(echo {} | cut -d"|" -f2)
      printf "\\033[1;34m=== BRANCH WITHOUT WORKTREE ===\\033[0m\\n"
      echo ""
      printf "\\033[1;33mBranch:\\033[0m %s\\n" "$BRANCH"
      printf "\\033[1;33mWill create worktree with git-worktree-add\\033[0m\\n"
      echo ""
      printf "\\033[1;33mRecent commits:\\033[0m\\n"
      REPO=$(git rev-parse --show-toplevel 2>/dev/null)
      if [ -n "$REPO" ]; then
        git -C "$REPO" -c color.ui=always log --oneline -5 "$BRANCH" 2>/dev/null \
          || git -C "$REPO" -c color.ui=always log --oneline -5 "origin/$BRANCH" 2>/dev/null \
          || echo "No commits found"
      else
        echo "No commits found"
      fi
    fi
  ' \
  --preview-window=right:50%:wrap \
  --header="Navigate to worktree or create new one (ESC to cancel)")

# Check if user cancelled
if [ -z "$SELECTED" ]; then
  echo "Cancelled." >&2
  exit 0
fi

# Extract type and path/branch from selection
SELECTED_TYPE=$(echo "$SELECTED" | cut -d'|' -f1)
SELECTED_VALUE=$(echo "$SELECTED" | cut -d'|' -f2)

if [ "$SELECTED_TYPE" = "WORKTREE" ]; then
  # Existing worktree - navigate to it
  SELECTED_PATH="$SELECTED_VALUE"
elif [ "$SELECTED_TYPE" = "BRANCH" ]; then
  # Branch without worktree - create it
  echo "Creating worktree for branch: $SELECTED_VALUE" >&2

  # Check if git-worktree-add exists
  if [ ! -x "$HOME/dotfiles/bin/git-worktree-add" ]; then
    echo "Error: git-worktree-add not found" >&2
    exit 1
  fi

  # Create the worktree (this will handle prompts and setup)
  if ! WORKTREE_PATH=$(GIT_WORKTREE_ADD_PRINT_PATH=1 "$HOME/dotfiles/bin/git-worktree-add" "$SELECTED_VALUE"); then
    exit 1
  fi

  # Output the path so the bash wrapper can cd to it
  echo "$WORKTREE_PATH"
  exit 0
fi

# Since we can't change the parent shell's directory from a script,
# we need to output the path for the shell function to use
echo "$SELECTED_PATH"
