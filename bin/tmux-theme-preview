RESET = "\033[0m"
BOLD = "\033[1m"
DIM = "\033[2m"

def hex_to_rgb(hex_str):
    hex_str = hex_str.lstrip('#')
    return tuple(int(hex_str[i:i+2], 16) for i in (0, 2, 4))

def fg(hex_str):
    r, g, b = hex_to_rgb(hex_str)
    return f"\033[38;2;{r};{g};{b}m"

def bg(hex_str):
    r, g, b = hex_to_rgb(hex_str)
    return f"\033[48;2;{r};{g};{b}m"

def render_statusbar(theme_id, prefix_active=False):
    t = THEMES[theme_id]
    c = t["colors"]
    bg_bar = c["bg_dark"]
    is_subtle = (theme_id in ("subtle", "dragon"))
    
    # Left side (Session)
    if is_subtle:
        if prefix_active:
            s_fg, _ = t["session_prefix"]
            s_icon = t["session_prefix_icon"]
            session_pill = f"{bg(bg_bar)}{fg(s_fg)}{BOLD} {s_icon} dotfiles {fg(c['fg_dim'])}│{RESET}"
        else:
            s_fg, _ = t["session_badge"]
            s_icon = t["session_icon"]
            session_pill = f"{bg(bg_bar)}{fg(s_fg)}{BOLD} {s_icon} dotfiles {fg(c['fg_dim'])}│{RESET}"
    else:
        if prefix_active:
            s_fg, s_bg = t["session_prefix"]
            s_icon = t["session_prefix_icon"]
            session_pill = f"{bg(s_bg)}{fg(s_fg)}{BOLD} {s_icon} dotfiles {RESET}"
        else:
            s_fg, s_bg = t["session_badge"]
            s_icon = t["session_icon"]
            session_pill = f"{bg(s_bg)}{fg(s_fg)}{BOLD} {s_icon} dotfiles {RESET}"

    # Tabs
    # Tab 1 (Inactive)
    in_num_fg, in_txt_fg, in_bg = t["inactive_tab"]
    if is_subtle:
        tab1 = f" {bg(in_bg)}{fg(in_num_fg)}1 {fg(in_txt_fg)}edit {fg(c['fg_dim'])}│{RESET}"
    else:
        tab1 = f" {bg(in_bg)}{fg(in_num_fg)} 1 {fg(in_txt_fg)}edit {RESET}"
    
    # Tab 2 (Active)
    act_num_fg, act_num_bg, act_txt_fg, act_bg = t["active_tab"]
    if is_subtle:
        tab2 = f" {bg(act_bg)}{fg(act_num_fg)}{BOLD}2 {fg(act_txt_fg)}{BOLD}nvim {fg(c['fg_dim'])}│{RESET}"
    else:
        tab2 = f" {bg(act_num_bg)}{fg(act_num_fg)}{BOLD} 2 {bg(act_bg)}{fg(act_txt_fg)}{BOLD} nvim {RESET}"
    
    # Tab 3 (Inactive)
    if is_subtle:
        tab3 = f" {bg(in_bg)}{fg(in_num_fg)}3 {fg(in_txt_fg)}server {fg(c['fg_dim'])}│{RESET}"
    else:
        tab3 = f" {bg(in_bg)}{fg(in_num_fg)} 3 {fg(in_txt_fg)}server {RESET}"
    
    # Right side
    div = f"{bg(bg_bar)}{fg(c.get('fg_dim', c.get('fg_muted')))}│{RESET}"
    right_parts = []
    for color, text in t["right_items"]:
        right_parts.append(f" {bg(bg_bar)}{fg(color)}{text}{RESET}")
    right_str = div.join(right_parts) + " "

    left_side = f"{session_pill}{bg(bg_bar)} {tab1}{tab2}{tab3} {RESET}"
    return left_side, right_str, bg_bar

def print_theme_card(theme_id, index=None):
    t = THEMES[theme_id]
    c = t["colors"]
    idx_str = f"[{index}] " if index is not None else ""
    
    print(f"\n{BOLD}{idx_str}{t['title']}{RESET}")
    print(f"  {DIM}{t['vibes']} — {t['description']}{RESET}")
    
    swatches = []
    for name, hex_val in list(c.items())[:8]:
        swatches.append(f"{bg(hex_val)}  {RESET} {fg(hex_val)}{hex_val}{RESET} {DIM}{name}{RESET}")
    print("  Palette: " + "  ".join(swatches[:4]))
    if len(swatches) > 4:
        print("           " + "  ".join(swatches[4:]))
    
    print(f"  {DIM}Normal Status Bar:{RESET}")
    left, right, bg_bar = render_statusbar(theme_id, prefix_active=False)
    print(f"    {left}  {right}")
    
    print(f"  {DIM}Prefix Active (C-a pressed):{RESET}")
    left_p, right_p, _ = render_statusbar(theme_id, prefix_active=True)
    print(f"    {left_p}  {right}")
    
    b_act = t["border_active"]
    b_inact = t["border_inactive"]
    print(f"  {DIM}Borders:{RESET} Active: {fg(b_act)}━━━━━ {b_act}{RESET}  Inactive: {fg(b_inact)}───── {b_inact}{RESET}")

def apply_theme(theme_name):
    # Support aliases
    if theme_name == "kanagawa-dragon":
        theme_name = "dragon"
        
    if theme_name not in THEMES:
        print(f"Error: Unknown theme '{theme_name}'. Available: {', '.join(THEMES.keys())}")
        return False
    
    script_path = os.path.expanduser(f"~/.tmux/themes/{THEMES[theme_name]['file']}")
    dotfiles_script = os.path.expanduser(f"~/dotfiles/tmux/themes/{THEMES[theme_name]['file']}")
    target = script_path if os.path.isfile(script_path) else dotfiles_script
    
    if not os.path.isfile(target):
        print(f"Error: Theme script not found at {target}")
        return False
    
    try:
        subprocess.run(["bash", target], check=True)
        print(f"\n{BOLD}✓ Applied '{THEMES[theme_name]['title']}' to your running tmux session!{RESET}")
        return True
    except subprocess.CalledProcessError as e:
        print(f"Failed to apply theme: {e}")
        return False

def set_default_theme(theme_name):
    if theme_name == "kanagawa-dragon":
        theme_name = "dragon"
        
    if not apply_theme(theme_name):
        return
    
    tmux_conf = os.path.expanduser("~/dotfiles/tmux/tmux.conf")
    if not os.path.isfile(tmux_conf):
        print(f"Error: tmux.conf not found at {tmux_conf}")
        return
    
    theme_file = THEMES[theme_name]['file']
    new_line = f'run-shell "[ -f ~/.tmux/themes/{theme_file} ] && ~/.tmux/themes/{theme_file} || true"\n'
    
    with open(tmux_conf, 'r') as f:
        content = f.read()
    
    pattern = r'run-shell "\[ -f ~/.tmux/themes/theme-[^.]+\.sh \].*"'
    if re.search(pattern, content):
        new_content = re.sub(pattern, f'run-shell "[ -f ~/.tmux/themes/{theme_file} ] && ~/.tmux/themes/{theme_file} || true"', content)
    else:
        new_content = content + f"\n{new_line}"
        
    with open(tmux_conf, 'w') as f:
        f.write(new_content)
    
    print(f"{BOLD}✓ Saved '{theme_file}' as default theme in {tmux_conf}!{RESET}")

def interactive_menu():
    print(f"\n{BOLD}======================================================{RESET}")
    print(f"{BOLD}           TMUX THEME GALLERY & LIVE SWITCHER         {RESET}")
    print(f"{BOLD}======================================================{RESET}")
    
    theme_keys = list(THEMES.keys())
    for idx, key in enumerate(theme_keys, 1):
        print_theme_card(key, index=idx)
    
    print(f"\n{BOLD}------------------------------------------------------{RESET}")
    print(f"Quick Commands:")
    print(f"  [1-{len(theme_keys)}] Apply theme live to running tmux session")
    print(f"  [s1-s{len(theme_keys)}] Apply AND save as permanent default in tmux.conf")
    print(f"  [q] Quit")
    
    try:
        choice = input(f"\n{BOLD}Select an option (e.g. 1 or s1): {RESET}").strip().lower()
        if choice == 'q' or not choice:
            print("Exiting.")
            return
        
        if choice.startswith('s') and choice[1:].isdigit():
            idx = int(choice[1:]) - 1
            if 0 <= idx < len(theme_keys):
                set_default_theme(theme_keys[idx])
        elif choice.isdigit():
            idx = int(choice) - 1
            if 0 <= idx < len(theme_keys):
                apply_theme(theme_keys[idx])
                print(f"{DIM}Tip: Enter 's{choice}' next time to make it your permanent startup theme.{RESET}")
    except (KeyboardInterrupt, EOFError):
        print("\nExited.")

def main():
    parser = argparse.ArgumentParser(description="Preview and switch tmux themes")
    parser.add_argument("--all", "-a", action="store_true", help="Display all theme visual mockups")
    parser.add_argument("--apply", metavar="NAME", help="Apply a theme live to the running tmux server")
    parser.add_argument("--set-default", metavar="NAME", help="Apply theme and set as permanent default in tmux.conf")
    parser.add_argument("--list", "-l", action="store_true", help="List available theme names")
    
    args = parser.parse_args()
    
    if args.list:
        for k, v in THEMES.items():
            print(f"- {k:10} : {v['title']}")
        return

    if args.apply:
        apply_theme(args.apply)
        return
        
    if args.set_default:
        set_default_theme(args.set_default)
        return
        
    if args.all:
        for key in THEMES:
            print_theme_card(key)
        return

    interactive_menu()

if __name__ == "__main__":
    main()
